{
  "name": "@kubohiroya/turbowarp-react-islands",
  "version": "0.2.0",
  "description": "TurboWarp extension and helpers for describing React islands in turbowarp-http-server HTML responses.",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-react-islands#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-react-islands.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-react-islands/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "react",
    "islands",
    "html",
    "turbowarp-http-server",
    "vite",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist/",
    "docs/",
    "schemas/",
    "src/",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "exports": {
    "./island": {
      "types": "./dist/island.d.ts",
      "import": "./dist/island.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.lib.json",
    "lint": "eslint src tests vite.config.ts",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.mjs",
    "docs:check": "pnpm run docs && git diff --exit-code -- README.md",
    "repo:check": "node scripts/check-repo.mjs",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run check:dist && pnpm run repo:check && pnpm run pack:check",
    "check:dist": "pnpm run build && node scripts/check-dist.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/vite-plugin-turbowarp-extension": "0.1.1",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
