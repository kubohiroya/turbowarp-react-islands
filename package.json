{
  "name": "@kubohiroya/turbowarp-react-islands",
  "version": "0.6.0",
  "description": "TurboWarp extension and helpers for describing React islands in turbowarp-http-server HTML responses.",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-react-islands#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-react-islands.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-react-islands/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "react",
    "islands",
    "html",
    "turbowarp-http-server",
    "vite",
    "typescript"
  ],
  "type": "module",
  "files": [
    "assets/",
    "dist/",
    "docs/",
    "src/",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "schemas/"
  ],
  "exports": {
    "./island": {
      "types": "./dist/island.d.ts",
      "import": "./dist/island.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.lib.json",
    "lint": "eslint src tests vite.config.ts",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.ts",
    "docs:check": "pnpm run docs && git diff --exit-code -- README.md",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run check:dist && pnpm run repo:check && pnpm run pack:check && pnpm run samples:check",
    "check:dist": "pnpm run build && node scripts/check-dist.ts",
    "samples:build": "node scripts/build-samples.mjs",
    "samples:check": "node scripts/build-samples.mjs --check && node --test scripts/verify-samples.mjs",
    "pages:build": "node scripts/prepare-pages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/turbowarp-extension-manifest": "^0.5.0",
    "@kubohiroya/vite-plugin-turbowarp-extension": "^0.10.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "@kubohiroya/turbowarp-extension-data-editor": "^0.5.0"
  },
  "gitHead": "78570baedc751aa5d6e1494eb13abb61eed8bc99",
  "x-turbowarp-source": {
    "revision": "78570baedc751aa5d6e1494eb13abb61eed8bc99",
    "revisionRole": "base-commit",
    "sourceState": "local-release-overlay"
  }
}
